<Window x:Class="PR7_Шаповалова.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PR7_Шаповалова"
        mc:Ignorable="d"
        Title="Фигуры" Height="450" Width="800" MinHeight="450" MinWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="33*"/>
            <RowDefinition Height="45*"/>
            <RowDefinition Height="32*"/>
            <RowDefinition Height="59*"/>
            <RowDefinition Height="265*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="92*"/>
            <ColumnDefinition Width="157*"/>
            <ColumnDefinition Width="154*"/>
            <ColumnDefinition Width="149*"/>
            <ColumnDefinition Width="140*"/>
            <ColumnDefinition Width="109*"/>
        </Grid.ColumnDefinitions>
        <Canvas x:Name="MyCanvas" Background="White" Grid.ColumnSpan="6" Grid.RowSpan="2" Margin="0,59,0,0" Grid.Row="3">
        </Canvas>
        <Button Click="okr_ris" Content="Нарисовать" Margin="0,6,7,6" Grid.Row="1"/>
        <Label Content="Окружность" Margin="10,0,5,0" VerticalAlignment="Center"/>
        <TextBox x:Name="X" Margin="21,1,8,12" Grid.Column="1" Grid.Row="1" />
        <Label Content="Центр Х" Margin="21,3,72,4" Grid.Column="1"/>
        <TextBox x:Name="Y" Margin="17,1,9,12" Grid.Column="2" Grid.Row="1" />
        <Label Content="Центр Y" Margin="17,0,72,0" VerticalAlignment="Center" Grid.Column="2"/>
        <TextBox x:Name="d" Margin="13,1,8,12" Grid.Column="3" Grid.Row="1" />
        <Label Content="Диаметр" Margin="13,4,69,3" Grid.Column="3"/>

        <Label Content="Треугольник" Grid.Row="2" Margin="6,3,7,3"/>
        <TextBox x:Name="X1" Margin="21,6,8,21" Grid.Column="1" Grid.Row="3" />
        <Label Content="Центр Х" Margin="24,3,72,3" Grid.Column="1" Grid.Row="2"/>
        <TextBox x:Name="Y1" Margin="17,6,9,21" Grid.Column="2" Grid.Row="3" />
        <Label Content="Центр Y" Margin="17,6,72,0" Grid.Column="2" Grid.Row="2"/>
        <TextBox x:Name="A" Margin="13,6,8,21" Grid.Column="3" Grid.Row="3" />
        <Label Content="Сторона 1" Margin="13,3,52,3" Grid.Column="3" Grid.Row="2"/>
        <TextBox x:Name="B" Margin="8,6,4,21" Grid.Column="4" Grid.Row="3" />
        <Label Content="Сторона 2" Margin="10,3,48,3" Grid.Column="4" Grid.Row="2"/>
        <TextBox x:Name="C" Margin="8,6,10,21" Grid.Column="5" Grid.Row="3" />
        <Label Content="Сторона 3" Margin="8,2,28,4" Grid.Column="5" Grid.Row="2"/>
        <Button Click="treug_ris" Content="Нарисовать" Margin="0,6,5,20" Grid.Row="3"/>
    </Grid>
</Window>
